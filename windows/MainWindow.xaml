<Window x:Class="Pulsar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pulsar"
        Title="Pulsar" Width="460" Height="820" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="LastChildFill" Value="False"/>
        </Style>
        <Style x:Key="Hint" TargetType="Border">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,12,20,0">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Image x:Name="Logo" Width="46" Height="46" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Pulsar" FontSize="24" FontWeight="Black"/>
                <TextBlock Text="Auto Clicker &amp; Macro Studio" Style="{StaticResource Sub}" FontWeight="Medium"/>
            </StackPanel>
        </DockPanel>

        <!-- Tabs -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1" CornerRadius="20" Padding="4" Margin="0,0,0,14">
            <UniformGrid Rows="1">
                <RadioButton x:Name="ClickerTab" Style="{StaticResource TabButton}" GroupName="tab" IsChecked="True" Content="Clicker"/>
                <RadioButton x:Name="MacroTab" Style="{StaticResource TabButton}" GroupName="tab" Content="Macro"/>
                <RadioButton x:Name="HotkeysTab" Style="{StaticResource TabButton}" GroupName="tab" Content="Hotkeys"/>
            </UniformGrid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
            <Grid Margin="0,0,0,16">

                <!-- ============ Clicker ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=ClickerTab, Converter={StaticResource Vis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" Margin="0,0,6,10"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="SPEED"/>
                            </StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBox Text="{Binding S.Cps, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Sub}" FontFamily="Consolas" Margin="0,4,0,0"
                                               Text="{Binding S.Cps, Converter={x:Static local:IntervalConverter.Instance}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding S.Cps, StringFormat={}{0:0.#}}" FontSize="46" FontWeight="Black"/>
                                    <TextBlock Text="clicks / sec" Style="{StaticResource Sub}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Bottom" Margin="8,0,0,12"/>
                                </StackPanel>
                            </DockPanel>
                            <Slider Minimum="1" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding S.Cps}"/>
                            <UniformGrid Rows="1" Margin="-3,10,-3,0">
                                <RadioButton Style="{StaticResource Pill}" GroupName="preset" Content="1" IsChecked="{Binding S.Cps, Converter={StaticResource Eq}, ConverterParameter=1}"/>
                                <RadioButton Style="{StaticResource Pill}" GroupName="preset" Content="5" IsChecked="{Binding S.Cps, Converter={StaticResource Eq}, ConverterParameter=5}"/>
                                <RadioButton Style="{StaticResource Pill}" GroupName="preset" Content="10" IsChecked="{Binding S.Cps, Converter={StaticResource Eq}, ConverterParameter=10}"/>
                                <RadioButton Style="{StaticResource Pill}" GroupName="preset" Content="20" IsChecked="{Binding S.Cps, Converter={StaticResource Eq}, ConverterParameter=20}"/>
                                <RadioButton Style="{StaticResource Pill}" GroupName="preset" Content="50" IsChecked="{Binding S.Cps, Converter={StaticResource Eq}, ConverterParameter=50}"/>
                                <RadioButton Style="{StaticResource Pill}" GroupName="preset" Content="100" IsChecked="{Binding S.Cps, Converter={StaticResource Eq}, ConverterParameter=100}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Button Click="ToggleClicking_Click" Margin="0,0,0,10">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BigButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Clicking}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource RecordBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="{Binding ClickButtonIcon}" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding ClickButtonText}" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Hint}">
                                <TextBlock Text="{Binding ToggleHint}" FontFamily="Consolas" FontSize="11" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Sub}" FontFamily="Consolas" FontSize="12" Margin="0,-2,0,10"
                               Visibility="{Binding Clicking, Converter={StaticResource Vis}}"
                               Text="{Binding ClickCount, StringFormat={}{0} clicks}"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE962;" Margin="0,0,6,10"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="MOUSE"/>
                            </StackPanel>
                            <UniformGrid Rows="1">
                                <RadioButton Style="{StaticResource Seg}" GroupName="button" Content="Left" IsChecked="{Binding S.Button, Converter={StaticResource Eq}, ConverterParameter=0}"/>
                                <RadioButton Style="{StaticResource Seg}" GroupName="button" Content="Right" IsChecked="{Binding S.Button, Converter={StaticResource Eq}, ConverterParameter=1}"/>
                                <RadioButton Style="{StaticResource Seg}" GroupName="button" Content="Middle" IsChecked="{Binding S.Button, Converter={StaticResource Eq}, ConverterParameter=2}"/>
                            </UniformGrid>
                            <UniformGrid Rows="1" Margin="0,8,0,0">
                                <RadioButton Style="{StaticResource Seg}" GroupName="double" Content="Single click" IsChecked="{Binding S.DoubleClick, Converter={StaticResource Eq}, ConverterParameter=False}"/>
                                <RadioButton Style="{StaticResource Seg}" GroupName="double" Content="Double click" IsChecked="{Binding S.DoubleClick, Converter={StaticResource Eq}, ConverterParameter=True}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE707;" Margin="0,0,6,10"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="POSITION"/>
                            </StackPanel>
                            <UniformGrid Rows="1">
                                <RadioButton Style="{StaticResource Seg}" GroupName="pos" Content="Follow cursor" IsChecked="{Binding S.UseFixedPoint, Converter={StaticResource Eq}, ConverterParameter=False}"/>
                                <RadioButton Style="{StaticResource Seg}" GroupName="pos" Content="Fixed point" IsChecked="{Binding S.UseFixedPoint, Converter={StaticResource Eq}, ConverterParameter=True}"/>
                            </UniformGrid>
                            <DockPanel Style="{StaticResource Row}" Margin="0,10,0,0"
                                       Visibility="{Binding S.UseFixedPoint, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding FixedPointText}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Picking}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="Pick_Click">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Pick Location"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Picking}" Value="True">
                                                        <Setter Property="Text" Value="Cancel"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" Margin="0,0,6,10"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="STOP AFTER"/>
                            </StackPanel>
                            <UniformGrid Rows="1">
                                <RadioButton Style="{StaticResource Seg}" GroupName="stop" Content="Never" IsChecked="{Binding S.StopMode, Converter={StaticResource Eq}, ConverterParameter=0}"/>
                                <RadioButton Style="{StaticResource Seg}" GroupName="stop" Content="Clicks" IsChecked="{Binding S.StopMode, Converter={StaticResource Eq}, ConverterParameter=1}"/>
                                <RadioButton Style="{StaticResource Seg}" GroupName="stop" Content="Time" IsChecked="{Binding S.StopMode, Converter={StaticResource Eq}, ConverterParameter=2}"/>
                            </UniformGrid>
                            <DockPanel Style="{StaticResource Row}" Margin="0,10,0,0"
                                       Visibility="{Binding S.StopMode, Converter={StaticResource Eq}, ConverterParameter=1}">
                                <TextBlock Text="Number of clicks" VerticalAlignment="Center"/>
                                <TextBox DockPanel.Dock="Right" Text="{Binding S.StopClicks, UpdateSourceTrigger=LostFocus}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}" Margin="0,10,0,0"
                                       Visibility="{Binding S.StopMode, Converter={StaticResource Eq}, ConverterParameter=2}">
                                <TextBlock Text="Seconds" VerticalAlignment="Center"/>
                                <TextBox DockPanel.Dock="Right" Text="{Binding S.StopSeconds, UpdateSourceTrigger=LostFocus}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B1;" Margin="0,0,6,10"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="HUMANIZE"/>
                            </StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Randomize interval"/>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Sub}" FontFamily="Consolas" FontSize="12"
                                           Text="{Binding S.Jitter, StringFormat={}±{0:0}%}"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding S.Jitter}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Macro ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=MacroTab, Converter={StaticResource Vis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C8;" Margin="0,0,6,10"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="RECORDER"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" FontSize="15"/>
                                <TextBlock Text="{Binding MacroTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMacroName}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <UniformGrid Rows="1" Margin="0,0,0,12">
                                <StackPanel><TextBlock Text="{Binding MacroEvents}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/><TextBlock Text="EVENTS" Style="{StaticResource Sub}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel><TextBlock Text="{Binding MacroLength}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/><TextBlock Text="LENGTH" Style="{StaticResource Sub}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel><TextBlock Text="{Binding MacroClicks}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/><TextBlock Text="CLICKS" Style="{StaticResource Sub}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel><TextBlock Text="{Binding MacroKeys}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/><TextBlock Text="KEYS" Style="{StaticResource Sub}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel>
                            </UniformGrid>
                            <Button Style="{StaticResource BigButton}" Background="{StaticResource RecordBrush}" Click="ToggleRecording_Click" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7C8;" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding RecordButtonText}" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource Hint}">
                                        <TextBlock Text="{Binding RecordHint}" FontFamily="Consolas" FontSize="11" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BigButton}" Background="{StaticResource PlayBrush}" Click="TogglePlaying_Click"
                                    IsEnabled="{Binding CanPlay}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="{Binding PlayButtonIcon}" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding PlayButtonText}" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource Hint}">
                                        <TextBlock Text="{Binding MacroHint}" FontFamily="Consolas" FontSize="11" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Sub}" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"
                                       Visibility="{Binding Playing, Converter={StaticResource Vis}}"
                                       Text="{Binding LoopCount, StringFormat='Loops completed: {0}'}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE9E9;" Margin="0,0,6,10"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="PLAYBACK"/>
                            </StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Repeat" VerticalAlignment="Center"/>
                                <TextBox DockPanel.Dock="Right" Width="70" Text="{Binding S.MacroRepeat, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Sub}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Text="{Binding RepeatText, StringFormat='{}{0}  (0 = forever)'}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}" Margin="0,8,0,0">
                                <TextBlock Text="Speed"/>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Sub}" FontFamily="Consolas" FontSize="12"
                                           Text="{Binding S.MacroSpeed, StringFormat={}{0:0.##}×}"/>
                            </DockPanel>
                            <Slider Minimum="0.25" Maximum="4" IsSnapToTickEnabled="True" TickFrequency="0.25" Value="{Binding S.MacroSpeed}"/>
                            <CheckBox Style="{StaticResource Switch}" Margin="0,12,0,0" IsChecked="{Binding S.RecordMoves}">
                                <TextBlock Text="Record mouse movement"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" Margin="0,0,6,10"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="LIBRARY"/>
                            </StackPanel>
                            <DockPanel LastChildFill="False">
                                <Button Style="{StaticResource Ghost}" Click="SaveMacro_Click" IsEnabled="{Binding CanSave}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE74E;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Save Macro…" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Ghost}" Click="OpenMacro_Click" IsEnabled="{Binding CanOpen}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8E5;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Open Macro…" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="ClearMacro_Click" IsEnabled="{Binding CanSave}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE74D;" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource RecordBrush}"/>
                                        <TextBlock Text="Clear" FontSize="12" Foreground="{StaticResource RecordBrush}"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Records clicks, drags, scrolls and keystrokes anywhere on screen. Clicks on Pulsar's own window are ignored — use the shortcut to stop recording from any app."/>
                </StackPanel>

                <!-- ============ Hotkeys ============ -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=HotkeysTab, Converter={StaticResource Vis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE765;" Margin="0,0,6,10"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="GLOBAL SHORTCUTS"/>
                            </StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Start / Stop Clicking" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Tag="toggle" Click="ClearSlot_Click" Margin="6,0,0,0" ToolTip="Remove shortcut">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE711;" FontSize="10"/>
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Tag="toggle" Click="Capture_Click" MinWidth="150">
                                    <TextBlock Text="{Binding ToggleSlotText}" FontWeight="SemiBold" FontSize="12"/>
                                </Button>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Play / Stop Macro" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Tag="macro" Click="ClearSlot_Click" Margin="6,0,0,0" ToolTip="Remove shortcut">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE711;" FontSize="10"/>
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Tag="macro" Click="Capture_Click" MinWidth="150">
                                    <TextBlock Text="{Binding MacroSlotText}" FontWeight="SemiBold" FontSize="12"/>
                                </Button>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Start / Stop Recording" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Tag="record" Click="ClearSlot_Click" Margin="6,0,0,0" ToolTip="Remove shortcut">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE711;" FontSize="10"/>
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Tag="record" Click="Capture_Click" MinWidth="150">
                                    <TextBlock Text="{Binding RecordSlotText}" FontWeight="SemiBold" FontSize="12"/>
                                </Button>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Margin="0,0,6,10"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="BEHAVIOR"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding S.HoldMode}">
                                <StackPanel>
                                    <TextBlock Text="Hold to click"/>
                                    <TextBlock Text="Clicks only while the start shortcut is held down." Style="{StaticResource Sub}"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Click a shortcut, then press any key combo (e.g. Ctrl+S, F6) or a mouse button — side buttons work too. Left/right click need a modifier. Esc cancels."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
